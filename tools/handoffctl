"""Command-line entry point for the coordination database."""

import sys

if len(sys.argv) > 2 and sys.argv[1] == "fast":
    from fast_receipt_socket import try_socket_fast

    fast_exit = try_socket_fast(sys.argv[1:])
    if fast_exit is not None:
        raise SystemExit(fast_exit)

from handoffctl import main

try:
    raise SystemExit(main())
except RuntimeError as error:
    sys.stderr.write(f"ERROR: {error}\n")
    raise SystemExit(1) from error
