{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/martin-beck/agent-workflow-coordinator/schema/role-registry.schema.json",
  "title": "Coordinator role registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "roles", "default_role", "default_awq_profile_refs"],
  "properties": {
    "schema_version": {"const": 1},
    "registry_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "role.schema.json"}
    },
    "default_role": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "default_awq_profile_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"}
    }
  }
}
