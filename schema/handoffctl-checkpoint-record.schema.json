{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workflow.example/schema/checkpoint-record.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "task", "task_revision", "recorded_at", "source_commit", "state", "body_digest", "artifact_refs"],
  "properties": {
    "schema_version": {"const": 1},
    "name": {"type": "string", "pattern": "^AR-[0-9]{4}-r[0-9]{4}$"},
    "task": {"type": "string", "pattern": "^AR-[0-9]{4}$"},
    "task_revision": {"type": "integer", "minimum": 1},
    "recorded_at": {"type": "string", "minLength": 1},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "state": {"type": "object"},
    "body_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact_refs": {"type": "array", "maxItems": 8, "items": {"type": "string", "minLength": 1}}
  }
}
