{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/martin-beck/agent-workflow-coordinator/schema/task-record.schema.json",
    "title": "Coordinator task record",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema_version",
        "id",
        "title",
        "status",
        "priority",
        "summary",
        "next_action",
        "task_revision",
        "updated_at"
    ],
    "properties": {
        "schema_version": {"const": 1},
        "id": {"$ref": "#/$defs/taskId"},
        "title": {"type": "string", "minLength": 1, "maxLength": 240},
        "short_title": {"type": "string", "minLength": 1, "maxLength": 120},
        "status": {
            "enum": [
                "in_progress",
                "open",
                "blocked",
                "planned",
                "future",
                "done",
                "cancelled",
                "superseded"
            ]
        },
        "priority": {"enum": ["P0", "P1", "P2", "P3", "P4"]},
        "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
        "next_action": {"type": "string", "minLength": 1, "maxLength": 4000},
        "task_revision": {"type": "integer", "minimum": 1},
        "updated_at": {"type": "string", "format": "date-time"},
        "owner": {"type": "string"},
        "role": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"},
        "team": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"},
        "claim_expires": {"type": "string"},
        "claim_process": {
            "oneOf": [
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["pid", "start_time"],
                    "properties": {
                        "pid": {"type": "integer", "minimum": 1},
                        "start_time": {"type": "integer", "minimum": 0}
                    }
                },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["pid", "start_time", "boot_digest", "pid_namespace"],
                    "properties": {
                        "pid": {"type": "integer", "minimum": 1},
                        "start_time": {"type": "integer", "minimum": 0},
                        "boot_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                        "pid_namespace": {"type": "string", "pattern": "^[0-9]+:[0-9]+$"}
                    }
                }
            ]
        },
        "worktree_key": {"type": "string"},
        "branch": {"type": "string"},
        "checkpoint_commit": {"type": "string"},
        "plan": {"type": "string"},
        "depends_on": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/taskId"}},
        "observed_branch": {"type": "string"},
        "observed_head": {"type": "string"},
        "observed_dirty": {"type": "boolean"},
        "superseded_by": {"$ref": "#/$defs/taskId"},
        "oracle_gate": {
            "type": "object",
            "properties": {"human_session": {"$ref": "#/$defs/humanSession"}}
        },
        "spec_ref": {"type": "string"},
        "spec_revision": {"type": "integer", "minimum": 1},
        "spec_acceptance": {},
        "parent_task_ref": {
            "anyOf": [{"type": "string", "maxLength": 0}, {"$ref": "#/$defs/taskId"}]
        },
        "children": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/taskId"}}
    },
    "$defs": {
        "taskId": {"type": "string", "pattern": "^AR-[0-9]{4}$"},
        "humanSession": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "schema_version",
                "session_id",
                "request_ref",
                "activation",
                "status",
                "task_revision",
                "tui_contract_version",
                "opened_at"
            ],
            "properties": {
                "schema_version": {"const": "1.0"},
                "session_id": {"type": "string", "pattern": "^AWTUI-[A-Z0-9-]{1,127}$"},
                "request_ref": {"type": "string", "pattern": "^AWG-[A-Z0-9-]{1,127}$"},
                "activation": {
                    "enum": [
                        "user-decision",
                        "user-detail-request",
                        "user-proposal-review",
                        "agent-uncertainty",
                        "policy-required-approval"
                    ]
                },
                "status": {"enum": ["presenting", "clarification_requested", "resolved"]},
                "task_revision": {"type": "integer", "minimum": 1},
                "tui_contract_version": {"const": "1.0"},
                "opened_at": {"type": "string", "format": "date-time"},
                "closed_at": {"type": "string", "format": "date-time"}
            },
            "allOf": [
                {
                    "if": {"properties": {"status": {"const": "presenting"}}},
                    "then": {"not": {"required": ["closed_at"]}}
                },
                {
                    "if": {
                        "properties": {"status": {"enum": ["clarification_requested", "resolved"]}}
                    },
                    "then": {"required": ["closed_at"]}
                }
            ]
        }
    }
}
