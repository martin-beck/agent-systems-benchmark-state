{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/martin-beck/agent-workflow-coordinator/schema/task-record.schema.json",
  "title": "Coordinator task record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "status", "priority", "summary", "next_action", "task_revision", "updated_at"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"$ref": "#/$defs/taskId"},
    "title": {"type": "string", "minLength": 1, "maxLength": 240},
    "status": {"enum": ["in_progress", "open", "blocked", "planned", "future", "done", "cancelled", "superseded"]},
    "priority": {"enum": ["P0", "P1", "P2", "P3", "P4"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
    "next_action": {"type": "string", "minLength": 1, "maxLength": 4000},
    "task_revision": {"type": "integer", "minimum": 1},
    "updated_at": {"type": "string", "format": "date-time"},
    "owner": {"type": "string"},
    "role": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"},
    "team": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"},
    "claim_expires": {"type": "string"},
    "worktree_key": {"type": "string"},
    "branch": {"type": "string"},
    "checkpoint_commit": {"type": "string"},
    "plan": {"type": "string"},
    "depends_on": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/taskId"}},
    "observed_branch": {"type": "string"},
    "observed_head": {"type": "string"},
    "observed_dirty": {"type": "boolean"},
    "superseded_by": {"$ref": "#/$defs/taskId"},
    "oracle_gate": {"type": "object"},
    "spec_ref": {"type": "string"},
    "spec_revision": {"type": "integer", "minimum": 1},
    "spec_acceptance": {},
    "parent_task_ref": {"anyOf": [{"type": "string", "maxLength": 0}, {"$ref": "#/$defs/taskId"}]},
    "children": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/taskId"}}
  },
  "$defs": {
    "taskId": {"type": "string", "pattern": "^AR-[0-9]{4}$"}
  }
}
