{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/martin-beck/agent-systems-benchmark-state/schema/task-schema.json",
  "title": "Agent Systems Benchmark coordination task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "status",
    "priority",
    "summary",
    "next_action",
    "task_revision",
    "updated_at",
    "owner",
    "claim_expires",
    "worktree_key",
    "branch",
    "checkpoint_commit",
    "plan",
    "depends_on"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^AR-[0-9]{4}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 120},
    "status": {
      "enum": [
        "in_progress",
        "open",
        "blocked",
        "planned",
        "future",
        "done",
        "cancelled",
        "superseded"
      ]
    },
    "priority": {"enum": ["P0", "P1", "P2", "P3", "P4"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 800},
    "next_action": {"type": "string", "minLength": 1, "maxLength": 800},
    "task_revision": {"type": "integer", "minimum": 1},
    "updated_at": {"type": "string", "format": "date-time"},
    "owner": {"type": "string", "maxLength": 80},
    "claim_expires": {"type": "string", "maxLength": 40},
    "worktree_key": {
      "type": "string",
      "pattern": "^(|(?:agent-systems-benchmark|asb-state-coordinator-v070)(?:-[a-z0-9-]+)?)$"
    },
    "branch": {"type": "string", "maxLength": 160},
    "checkpoint_commit": {"type": "string", "pattern": "^(|[0-9a-f]{40})$"},
    "plan": {"type": "string", "pattern": "^(|\\.\\./plans/AR-[0-9]{4}(?:-[a-z0-9-]+)?\\.md)$"},
    "depends_on": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^AR-[0-9]{4}$"}
    },
    "observed_branch": {"type": "string", "maxLength": 160},
    "observed_head": {"type": "string", "pattern": "^(|[0-9a-f]{40})$"},
    "superseded_by": {"type": "string", "pattern": "^AR-[0-9]{4}$"},
    "observed_dirty": {"type": "integer", "minimum": 0},
    "oracle_gate": {"$ref": "#/$defs/oracleGate"},
    "spec_ref": {"type": "string", "pattern": "^specs/AR-[0-9]{4}\\.json$"},
    "spec_revision": {"type": "integer", "minimum": 1},
    "spec_acceptance": {"type": "object", "additionalProperties": true},
    "evidence_ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_ref", "candidate_digest", "steps"],
      "properties": {
        "candidate_ref": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.)(?!.*//)[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$"},
        "candidate_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["predicate_id", "status", "candidate_ref", "candidate_digest", "evidence_class", "evidence_ref", "evidence_digest", "recorded_task_revision"],
            "properties": {
              "predicate_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$"},
              "status": {"enum": ["pass", "stale"]},
              "candidate_ref": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.)(?!.*//)[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$"},
              "candidate_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "evidence_class": {"enum": ["mechanical", "contract-test", "property-or-fuzz", "bounded-model", "environmental"]},
              "evidence_ref": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.)(?!.*//)[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$"},
              "evidence_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "recorded_task_revision": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "digest"],
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\.)(?!.*//)[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
        },
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "interactionEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id", "task_revision", "stage", "action", "disposition",
        "before", "after", "public_ref", "recorded_at"
      ],
      "properties": {
        "task_id": {"type": "string", "pattern": "^AR-[0-9]{4}$"},
        "task_revision": {"type": "integer", "minimum": 1},
        "stage": {
          "enum": ["intake", "discussion", "formal_spec_review", "reconciliation", "role", "spec", "decision"]
        },
        "action": {"enum": ["open", "resolve", "reopen"]},
        "disposition": {
          "enum": ["accepted", "rejected", "clarify", "user-added-option", "contradiction", "unresolved"]
        },
        "before": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/artifactRef"}},
        "after": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/artifactRef"}},
        "public_ref": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\.)(?!.*//)[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
        },
        "recorded_at": {"type": "string", "format": "date-time"}
      }
    },
    "humanSession": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "session_id", "request_ref", "activation", "status",
        "task_revision", "tui_contract_version", "opened_at"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "session_id": {"type": "string", "pattern": "^AWTUI-[A-Z0-9-]{1,127}$"},
        "request_ref": {"type": "string", "pattern": "^AWG-[A-Z0-9-]{1,127}$"},
        "activation": {
          "enum": ["user-decision", "user-detail-request", "user-proposal-review", "agent-uncertainty", "policy-required-approval"]
        },
        "status": {"enum": ["presenting", "clarification_requested", "resolved"]},
        "task_revision": {"type": "integer", "minimum": 1},
        "tui_contract_version": {"const": "1.0"},
        "opened_at": {"type": "string", "format": "date-time"},
        "closed_at": {"type": "string", "format": "date-time"}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "presenting"}}}, "then": {"not": {"required": ["closed_at"]}}},
        {"if": {"properties": {"status": {"enum": ["clarification_requested", "resolved"]}}}, "then": {"required": ["closed_at"]}}
      ]
    },
    "oracleGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "open_stage", "completed", "events"],
      "properties": {
        "required": {"const": true},
        "stage_sequence": {
          "type": "array", "minItems": 1, "maxItems": 7, "uniqueItems": true,
          "items": {"enum": ["intake", "discussion", "formal_spec_review", "reconciliation", "role", "spec", "decision"]}
        },
        "open_stage": {
          "anyOf": [{"type": "null"}, {"enum": ["intake", "discussion", "formal_spec_review", "reconciliation", "role", "spec", "decision"]}]
        },
        "completed": {
          "type": "array", "maxItems": 7, "uniqueItems": true,
          "items": {"enum": ["intake", "discussion", "formal_spec_review", "reconciliation", "role", "spec", "decision"]}
        },
        "events": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/interactionEvent"}},
        "human_session": {"$ref": "#/$defs/humanSession"},
        "authorized": {"type": "boolean"},
        "discussion_rounds": {"type": "integer", "minimum": 0, "maximum": 16},
        "reconciliation_required": {"type": "boolean"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "in_progress"}}},
      "then": {
        "properties": {
          "owner": {"minLength": 1},
          "claim_expires": {"minLength": 20}
        }
      },
      "else": {
        "properties": {
          "owner": {"maxLength": 0},
          "claim_expires": {"maxLength": 0}
        }
      }
    }
  ]
}
