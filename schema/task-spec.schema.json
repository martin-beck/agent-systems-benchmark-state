{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/martin-beck/agent-workflow-coordinator/schema/task-spec.schema.json",
  "title": "Coordinator task specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "spec_ref", "spec_revision", "acceptance_predicates", "definition_of_done", "inputs", "outputs", "allowed_tools", "forbidden_tools", "required_evidence_classes", "gates"],
  "properties": {
    "schema_version": {"const": 1},
    "spec_ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{2,255}$"},
    "spec_revision": {"type": "integer", "minimum": 1},
    "acceptance_predicates": {"$ref": "#/$defs/namedItems"},
    "definition_of_done": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
    "inputs": {"$ref": "#/$defs/namedItems"},
    "outputs": {"$ref": "#/$defs/namedItems"},
    "allowed_tools": {"$ref": "#/$defs/tools"},
    "forbidden_tools": {"$ref": "#/$defs/tools"},
    "required_evidence_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2, "maxLength": 32, "pattern": "^[a-z]+(?:-[a-z]+)*$"}},
    "gates": {"$ref": "#/$defs/namedItems"}
  },
  "$defs": {
    "namedItems": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "description"], "properties": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$"}, "description": {"type": "string", "minLength": 1, "maxLength": 1000}}}},
    "tools": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"}}
  }
}
